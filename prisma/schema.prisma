generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id           String       @id @default(cuid())
  nome         String
  slug         String       @unique
  icone        String?
  fornecedores Fornecedor[]
  criadoEm    DateTime     @default(now())
}

model Fornecedor {
  id           String      @id @default(cuid())
  nome         String
  slug         String      @unique
  tagline      String?
  descricao    String      @db.Text
  logo         String?
  banner       String?
  plano        Plano       @default(BASICO)
  ativo        Boolean     @default(true)
  recomendado  Boolean     @default(false)
  categoria    Categoria   @relation(fields: [categoriaId], references: [id])
  categoriaId  String
  regioes      String[]
  whatsapp     String?
  email        String?
  site         String?
  video        String?
  produtos     Produto[]
  promocoes    Promocao[]
  criadoEm    DateTime    @default(now())
  atualizadoEm DateTime   @updatedAt
}

model Produto {
  id           String     @id @default(cuid())
  nome         String
  descricao    String?    @db.Text
  preco        String?
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  fornecedorId String
  ativo        Boolean    @default(true)
  ordem        Int        @default(0)
  criadoEm    DateTime   @default(now())
}

model Promocao {
  id           String     @id @default(cuid())
  titulo       String
  descricao    String     @db.Text
  validade     DateTime?
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  fornecedorId String
  ativo        Boolean    @default(true)
  criadoEm    DateTime   @default(now())
}

model Banner {
  id       String     @id @default(cuid())
  tipo     TipoBanner
  titulo   String?
  imagem   String
  link     String?
  ativo    Boolean    @default(true)
  ordem    Int        @default(0)
  criadoEm DateTime  @default(now())
}

model Pageview {
  id       String   @id @default(cuid())
  path     String
  criadoEm DateTime @default(now())

  @@index([criadoEm])
}

model VisitaAtiva {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  path         String
  atualizadoEm DateTime @updatedAt

  @@index([atualizadoEm])
}

model Provedor {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  telefone  String?
  cidade    String?
  estado    String?
  criadoEm DateTime @default(now())
}

model Solicitacao {
  id        String            @id @default(cuid())
  empresa   String
  email     String
  telefone  String?
  mensagem  String?           @db.Text
  status    StatusSolicitacao @default(PENDENTE)
  criadoEm DateTime          @default(now())
}

enum Plano {
  BASICO
  DESTAQUE
  PREMIUM
}

enum TipoBanner {
  HORIZONTAL_TOPO
  HORIZONTAL_RODAPE
  VERTICAL_ESQUERDA
  VERTICAL_DIREITA
}

enum StatusSolicitacao {
  PENDENTE
  APROVADO
  REJEITADO
}
